---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '唯蟹 Team — We Quest On and On',
  description = 'We Quest On and On'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://www.wxies.cn');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // 先于首帧渲染打标：滚动入场动画的初始隐藏态只在 JS 可用时生效
      document.documentElement.classList.add('js');
    </script>
    <link rel="preconnect" href="https://static.horatio.cn" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="唯蟹Team, Xies' Group, Blog233, HoratioWeb, lujing, jack" />
    <link rel="shortcut icon" href="/favicon-64.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="/favicon.png" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/favicon.png" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "唯蟹 Team",
      "url": "https://www.wxies.cn",
      "logo": "https://www.wxies.cn/favicon.png",
      "description": "一群热爱技术、专注于创造有趣数字世界的伙伴们",
      "member": [
        { "@type": "Person", "name": "Horatio", "url": "https://horatio.cn/" },
        { "@type": "Person", "name": "Jack", "url": "https://blog.wj0.top/" }
      ]
    })} />

    <ClientRouter />
  </head>
  <body class="antialiased">
    <slot />

    <script is:inline>
      // ClientRouter 换页会重新执行本脚本：用 IIFE + 标记避免重复声明与重复注册
      (() => {
        if (window.__revealHooked) return;
        window.__revealHooked = true;
        const initReveal = () => {
          const els = document.querySelectorAll('[data-reveal]');
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduce || !('IntersectionObserver' in window)) {
            els.forEach((el) => el.classList.add('is-visible'));
            return;
          }
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
          );
          els.forEach((el) => io.observe(el));
        };
        document.addEventListener('astro:page-load', initReveal);
      })();
    </script>
  </body>
</html>
